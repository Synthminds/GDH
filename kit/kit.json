{
  "name": "gdh",
  "displayName": "Global Design Harness",
  "version": "0.1.1",
  "description": "Design skills, rules and tool catalogs for brand, web, app, dashboard, data, 3D and motion work.",
  "author": {
    "name": "Synthminds"
  },
  "repository": "https://github.com/Synthminds/GDH",
  "license": "UNLICENSED",
  "budgets": {
    "modelDescriptionChars": 5000,
    "kernelLines": 60,
    "momentsChars": 3500
  },
  "skills": {
    "align": {
      "invocation": "model",
      "origin": "gdh",
      "discipline": "alignment"
    },
    "ask-gdh": {
      "invocation": "model",
      "origin": "gdh",
      "discipline": "router"
    },
    "design-brief": {
