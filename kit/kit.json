      "invocation": "user",
      "origin": "gdh",
      "discipline": "evolution"
    }
  },
  "agents": [
    "art-director",
    "design-critic",
    "asset-scout",
    "a11y-auditor"
  ],
  "moments": [
    {
      "when": "The first design-led request of a session arrives: a brand or logo, a mood board, the look of a site or app, a dashboard or chart design, an infographic, 3D, animation or motion graphics, or a design system",
      "start": [
        "align"
      ],
      "offer": []
    },
    {
      "when": "`align` has closed in this session and the design work needs a plan, or the user asks what GDH can do",
      "start": [
        "ask-gdh"
      ],
      "offer": []
    },
    {
      "when": "You are about to choose a look, a palette or a typeface and no confirmed brief exists, or the audience, job or brand changed",
      "start": [
        "align"
      ],
      "offer": []
    },
    {
      "when": "A confirmed brief must change, or another skill needs to read or check the brief",
      "start": [
        "design-brief"
      ],
      "offer": []
    },
    {
      "when": "You are about to build a full design and no direction is chosen",
      "start": [
        "mood-board"
      ],
      "offer": []
    },
    {
      "when": "You need an outside image, icon, font, component, model or template",
      "start": [
        "find-assets"
      ],
      "offer": []
    },
    {
      "when": "You are about to tell the user a design is done",
      "start": [
        "design-critique"
      ],
      "offer": [
        "accessibility-gate"
      ]
    },
    {
      "when": "The user gives feedback on a design",
      "start": [],
      "offer": [
        "refine-round"
      ]
    },
    {
      "when": "The user names a tool, connector or asset source that the catalog does not hold",
      "start": [],
      "offer": [
        "add-design-tool"
      ]
    },
    {
      "when": "A design is approved and code work starts",
      "start": [],
      "offer": [
        "handoff-to-code"
      ]
    }
  ],
  "wired": {
    "impeccable": {
      "name": "Impeccable",
      "what": "design critique and polish for a screen",
      "install": "/plugin marketplace add pbakaus/impeccable",
      "source": "https://github.com/pbakaus/impeccable"
    },
    "dashboard-design-skill": {
      "name": "Dashboard Design (skill)",
      "what": "dashboard playbooks, layouts, component patterns and a screenshot QA pass",
      "install": [
        "/plugin marketplace add abdiraimov-otabek/dashboard-design-skill",
        "/plugin install dashboard-design@dashboard-design-skill"
      ],
      "source": "https://github.com/abdiraimov-otabek/dashboard-design-skill"
    },
    "design-taste-frontend": {
      "name": "design-taste-frontend",
      "what": "layout and visual taste for a landing page or a company site",
      "install": "npx skills@1.8.1 add Leonxlnx/taste-skill@f6b76575f949707b4e3c37cd86cb44b0b98643e8 --skill design-taste-frontend",
      "source": "https://github.com/Leonxlnx/taste-skill"
    },
    "deslop": {
      "name": "DeSlop",
      "what": "a scan for AI-writing tells in marketing copy and brand voice",
      "install": [
        "/plugin marketplace add ProfSynapse/synaptic-labs-plugins",
        "/plugin install deslop@synaptic-labs"
      ],
      "source": "https://github.com/ProfSynapse/synaptic-labs-plugins"
    }
  },
  "requires": {
    "gch": {
      "optional": true,
      "note": "No hard requirement. GCH is a separate coding harness that is not part of this kit and is not distributed with it. When the GCH kernel is loaded, GCH governs code work."
    }
  }
}
